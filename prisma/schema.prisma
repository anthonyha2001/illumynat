generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum UnitOfMeasure {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  OUNCE
  PIECE
  METER
  CENTIMETER
}

enum RecipeVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  FULFILLED
  SHIPPED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  COD
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PromoCodeType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum GiftCardTransactionType {
  ISSUED
  REDEEMED
  REFUNDED
  ADJUSTED
}

enum AccountType {
  ASSET     // normal balance: DEBIT  (cash, inventory, receivables)
  LIABILITY // normal balance: CREDIT (payables, tax payable, gift card liability)
  EQUITY    // normal balance: CREDIT (owner's equity)
  REVENUE   // normal balance: CREDIT (product revenue)
  EXPENSE   // normal balance: DEBIT  (COGS, operating expenses)
}

enum CustomizationType {
  TEXT_INPUT  // free text input (e.g. label engraving, gift message)
  SELECT      // choose one from a list of options
  CHECKBOX    // boolean add-on (e.g. gift wrap yes/no)
}

enum ReviewStatus {
  PENDING   // awaiting admin approval
  PUBLISHED // visible on storefront
  REJECTED  // not approved
}

enum AdminNotifType {
  NEW_ORDER
  NEW_CUSTOMER
  NEWSLETTER_SIGNUP
  NEW_MESSAGE
}

enum ThreadStatus {
  OPEN
  CLOSED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REFUNDED
  REJECTED
}

enum LoyaltyTier {
  BRONZE   // 0 – 499 lifetime points
  SILVER   // 500 – 1 999 lifetime points
  GOLD     // 2 000+ lifetime points
}

enum LoyaltyTransactionType {
  EARNED_SIGNUP
  EARNED_PURCHASE
  EARNED_REVIEW
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum JournalEntryRef {
  ORDER            // revenue recognition + COGS on order fulfilment
  PRODUCTION       // raw material → finished goods on batch completion
  STOCK_IN         // raw material purchase
  GIFT_CARD_SALE   // gift card sold → deferred revenue (liability)
  GIFT_CARD_REDEEM // gift card redeemed → revenue recognised
  MANUAL           // admin manual entry
}

// ─────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String
  lastName  String
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses             Address[]
  orders                Order[]
  giftCards             GiftCard[]
  wishlistItems         WishlistItem[]
  reviews               ProductReview[]
  loyaltyAccount        LoyaltyAccount?
  customerNotifications CustomerNotification[]
  contactThreads        ContactThread[]

  @@map("profiles")
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  profileId    String  @db.Uuid
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  label        String?
  firstName    String
  lastName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  country      String  @default("LB")
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// ─────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique
  name        String
  slug        String        @unique
  description String
  story       String?
  price       Decimal       @db.Decimal(10, 2)
  taxable     Boolean       @default(true)
  status      ProductStatus @default(DRAFT)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  burnTime       String?
  netWeight      String?
  dimensions     String?
  waxType        String?
  fragranceNotes String?
  scentFamily    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images            ProductImage[]
  recipe            Recipe?
  finishedGoods     FinishedGoods?
  productionBatches ProductionBatch[]
  orderItems        OrderItem[]
  customizations    ProductCustomization[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  giftSetItems      GiftSetItem[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("product_images")
}

// ─────────────────────────────────────────
// RAW MATERIALS & STOCK
// ─────────────────────────────────────────

model RawMaterial {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?

  consumptionUnit  UnitOfMeasure
  purchaseUnit     UnitOfMeasure
  conversionFactor Decimal       @db.Decimal(10, 6)

  currentStock     Decimal @db.Decimal(12, 4) @default(0)
  averageCost      Decimal @db.Decimal(10, 6) @default(0)
  reorderThreshold Decimal @db.Decimal(12, 4) @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLots         StockLot[]
  recipeIngredients RecipeIngredient[]
  batchDeductions   BatchDeduction[]

  @@map("raw_materials")
}

model StockLot {
  id            String      @id @default(uuid()) @db.Uuid
  rawMaterialId String      @db.Uuid
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  quantityPurchased   Decimal @db.Decimal(12, 4)
  costPerPurchaseUnit Decimal @db.Decimal(10, 6)

  quantityReceived Decimal @db.Decimal(12, 4)
  costPerUnit      Decimal @db.Decimal(10, 6)
  totalCost        Decimal @db.Decimal(12, 4)

  avgCostBefore Decimal @db.Decimal(10, 6)
  avgCostAfter  Decimal @db.Decimal(10, 6)

  supplier   String?
  notes      String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  journalEntry JournalEntry?

  @@map("stock_lots")
}

// ─────────────────────────────────────────
// RECIPE & VERSIONING
// ─────────────────────────────────────────

model Recipe {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions RecipeVersion[]

  @@map("recipes")
}

model RecipeVersion {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @db.Uuid
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        RecipeVersionStatus @default(DRAFT)
  yieldQuantity Int
  notes         String?

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ingredients       RecipeIngredient[]
  productionBatches ProductionBatch[]

  @@unique([recipeId, versionNumber])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id              String        @id @default(uuid()) @db.Uuid
  recipeVersionId String        @db.Uuid
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)

  rawMaterialId String      @db.Uuid
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  quantity Decimal @db.Decimal(12, 4)
  notes    String?

  @@unique([recipeVersionId, rawMaterialId])
  @@map("recipe_ingredients")
}

// ─────────────────────────────────────────
// PRODUCTION & FINISHED GOODS
// ─────────────────────────────────────────

model ProductionBatch {
  id              String        @id @default(uuid()) @db.Uuid
  recipeVersionId String        @db.Uuid
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  status         BatchStatus @default(PENDING)
  targetQuantity Int

  actualQuantity Int?
  failedQuantity Int?

  totalMaterialCost Decimal? @db.Decimal(12, 4)
  costPerUnit       Decimal? @db.Decimal(10, 6)

  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deductions   BatchDeduction[]
  journalEntry JournalEntry?

  @@map("production_batches")
}

model BatchDeduction {
  id                String          @id @default(uuid()) @db.Uuid
  productionBatchId String          @db.Uuid
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  rawMaterialId String      @db.Uuid
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  quantityDeducted Decimal @db.Decimal(12, 4)
  costPerUnit      Decimal @db.Decimal(10, 6)
  totalCost        Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())

  @@map("batch_deductions")
}

model FinishedGoods {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOnHand Int     @default(0)
  averageCost    Decimal @db.Decimal(10, 6) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finished_goods")
}

// ─────────────────────────────────────────
// COMMERCE & ORDERS
// ─────────────────────────────────────────

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique

  status OrderStatus @default(PENDING)

  profileId String?  @db.Uuid
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  guestEmail     String?
  guestFirstName String?
  guestLastName  String?
  guestPhone     String?

  shippingFirstName    String
  shippingLastName     String
  shippingAddressLine1 String
  shippingAddressLine2 String?
  shippingCity         String
  shippingState        String
  shippingZipCode      String
  shippingCountry      String @default("LB")

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2) @default(0)
  taxAmount      Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  promoCodeId String?    @db.Uuid
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  giftCardAmount Decimal? @db.Decimal(10, 2)

  customerNotes String?
  adminNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items               OrderItem[]
  payments            Payment[]
  shipment            Shipment?
  journalEntries      JournalEntry[]
  returns             Return[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  sku      String
  name     String
  price    Decimal @db.Decimal(10, 2)
  quantity Int
  subtotal Decimal @db.Decimal(10, 2)

  customizations OrderItemCustomization[]
  returnItems    ReturnItem[]

  @@map("order_items")
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal       @db.Decimal(10, 2)

  stripePaymentIntentId String? @unique

  giftCardId String?   @db.Uuid
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: SetNull)

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("payments")
}

model Shipment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier           String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  notes             String?

  shippedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ─────────────────────────────────────────
// PROMOTIONS
// ─────────────────────────────────────────

model PromoCode {
  id   String        @id @default(uuid()) @db.Uuid
  code String        @unique
  type PromoCodeType

  value              Decimal @db.Decimal(10, 2)
  minimumOrderAmount Decimal @db.Decimal(10, 2) @default(0)

  maxRedemptions  Int?
  redemptionCount Int  @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("promo_codes")
}

model GiftCard {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  initialBalance Decimal @db.Decimal(10, 2)
  currentBalance Decimal @db.Decimal(10, 2)

  issuedToProfileId String?  @db.Uuid
  issuedToProfile   Profile? @relation(fields: [issuedToProfileId], references: [id], onDelete: SetNull)
  issuedToEmail     String?

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  GiftCardTransaction[]
  payments      Payment[]
  journalEntries JournalEntry[]

  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String                  @id @default(uuid()) @db.Uuid
  giftCardId String                  @db.Uuid
  giftCard   GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  type         GiftCardTransactionType
  amount       Decimal @db.Decimal(10, 2)
  balanceAfter Decimal @db.Decimal(10, 2)
  orderId      String? @db.Uuid
  notes        String?

  createdAt DateTime @default(now())

  @@map("gift_card_transactions")
}

// ─────────────────────────────────────────
// DOUBLE-ENTRY ACCOUNTING
// ─────────────────────────────────────────

model Account {
  id   String      @id @default(uuid()) @db.Uuid
  code String      @unique // e.g. "1000", "4000"
  name String      @unique // e.g. "Cash", "Product Revenue"
  type AccountType

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]

  @@map("accounts")
}

model JournalEntry {
  id          String          @id @default(uuid()) @db.Uuid
  date        DateTime        @default(now())
  description String
  refType     JournalEntryRef

  // Source record references — at most one is populated per entry
  orderId         String? @db.Uuid
  order           Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  productionBatchId String?          @unique @db.Uuid
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)

  stockLotId String?   @unique @db.Uuid
  stockLot   StockLot? @relation(fields: [stockLotId], references: [id], onDelete: SetNull)

  giftCardId String?   @db.Uuid
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  lines JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  debit  Decimal? @db.Decimal(12, 2) // populated for debit lines
  credit Decimal? @db.Decimal(12, 2) // populated for credit lines
  note   String?

  createdAt DateTime @default(now())

  @@map("journal_lines")
}

// ─────────────────────────────────────────
// PRODUCT CUSTOMIZATION
// ─────────────────────────────────────────

model ProductCustomization {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @db.Uuid
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String          // e.g. "Label Engraving", "Gift Wrap", "Gift Message"
  description   String?         // shown to customer below the input
  type          CustomizationType
  isRequired    Boolean         @default(false)
  priceModifier Decimal         @db.Decimal(10, 2) @default(0) // extra charge for this customisation
  maxLength     Int?            // character limit for TEXT_INPUT
  placeholder   String?         // hint text shown inside text inputs
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)

  options                 CustomizationOption[]
  orderItemCustomizations OrderItemCustomization[]

  @@map("product_customizations")
}

model CustomizationOption {
  id              String               @id @default(uuid()) @db.Uuid
  customizationId String               @db.Uuid
  customization   ProductCustomization @relation(fields: [customizationId], references: [id], onDelete: Cascade)

  label         String          // displayed to customer
  priceModifier Decimal         @db.Decimal(10, 2) @default(0) // additional charge for this option
  sortOrder     Int             @default(0)

  @@map("customization_options")
}

model OrderItemCustomization {
  id              String               @id @default(uuid()) @db.Uuid
  orderItemId     String               @db.Uuid
  orderItem       OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  customizationId String               @db.Uuid
  customization   ProductCustomization @relation(fields: [customizationId], references: [id])

  label         String  // snapshot of customization name at order time
  value         String  // the customer's input or selected option label
  priceModifier Decimal @db.Decimal(10, 2) @default(0) // snapshot of price modifier

  @@map("order_item_customizations")
}

// ─────────────────────────────────────────
// WISHLIST
// ─────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, productId]) // one entry per product per customer
  @@map("wishlist_items")
}

// ─────────────────────────────────────────
// GIFT SETS
// ─────────────────────────────────────────

model GiftSet {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  subtitle    String?
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  tag         String? // e.g. "Most Gifted", "Best Value"
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GiftSetItem[]

  @@map("gift_sets")
}

model GiftSetItem {
  id        String  @id @default(uuid()) @db.Uuid
  giftSetId String  @db.Uuid
  giftSet   GiftSet @relation(fields: [giftSetId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int    @default(1)
  sortOrder Int    @default(0)

  @@map("gift_set_items")
}

// ─────────────────────────────────────────
// PRODUCT REVIEWS
// ─────────────────────────────────────────

model ProductReview {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  orderId String @db.Uuid // must have purchased to review — verified purchase badge

  rating  Int          // 1–5
  title   String?
  body    String
  status  ReviewStatus @default(PENDING) // admin approves before publishing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, productId]) // one review per product per customer
  @@map("product_reviews")
}

// ─────────────────────────────────────────
// SETTINGS (key-value store)
// ─────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────
// SITE CONTENT (CMS — Hero, Promo Zone)
// ─────────────────────────────────────────

model SiteContent {
  key       String   @id   // e.g. "hero", "promo_zone"
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// ─────────────────────────────────────────
// RETURNS & REFUNDS
// ─────────────────────────────────────────

model Return {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reason         String
  notes          String?
  status         ReturnStatus @default(REQUESTED)
  refundAmount   Decimal      @db.Decimal(10, 2)
  stripeRefundId String?

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("returns")
}

model ReturnItem {
  id          String    @id @default(uuid()) @db.Uuid
  returnId    String    @db.Uuid
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity Int
  reason   String?

  @@map("return_items")
}

// ─────────────────────────────────────────
// CONTACT / MESSAGING
// ─────────────────────────────────────────

model ContactThread {
  id         String       @id @default(uuid()) @db.Uuid
  profileId  String?      @db.Uuid
  profile    Profile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)

  guestName  String?
  guestEmail String?

  subject    String
  topic      String?
  status     ThreadStatus @default(OPEN)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   ContactMessage[]

  @@map("contact_threads")
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  threadId  String        @db.Uuid
  thread    ContactThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  body      String
  fromAdmin Boolean       @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model AdminNotification {
  id        String         @id @default(uuid()) @db.Uuid
  type      AdminNotifType
  title     String
  body      String
  metadata  Json?          // { orderId, orderNumber, profileId, email, amount }
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@map("admin_notifications")
}

model CustomerNotification {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title     String
  body      String
  metadata  Json?    // { orderId, orderNumber, status, href }
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("customer_notifications")
}

// ─────────────────────────────────────────
// LOYALTY / CRM
// ─────────────────────────────────────────

model LoyaltyAccount {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @unique @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  totalPoints    Int         @default(0)   // spendable balance
  lifetimePoints Int         @default(0)   // never decrements — used for tier calc
  tier           LoyaltyTier @default(BRONZE)

  transactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String         @id @default(uuid()) @db.Uuid
  accountId String         @db.Uuid
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  points      Int                    // positive = earned / negative = redeemed
  type        LoyaltyTransactionType
  description String
  orderId     String?                @db.Uuid
  order       Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("loyalty_transactions")
}
